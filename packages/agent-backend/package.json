{
  "name": "@dev-workflow-ai/agent-backend",
  "version": "0.2.0",
  "description": "Autonomous AI engineer — Fastify API + LangGraph agent",
  "license": "EPL-2.0",
  "type": "module",
  "main": "lib/server/index.js",
  "scripts": {
    "build": "webpack --color --config webpack.config.cjs --mode production",
    "build:dev": "webpack --color --config webpack.config.cjs --mode development",
    "build:watch": "yarn build:dev --watch",
    "start": "node lib/server/index.js",
    "start:debug": "node --inspect lib/server/index.js",
    "format:check": "prettier --check 'src/**/*.ts'",
    "format:fix": "prettier --write 'src/**/*.ts'",
    "lint:check": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint 'src/**/*.ts' --fix",
    "test": "vitest run --project backend"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@langchain/openai": "^1.5.12"
  }
}
