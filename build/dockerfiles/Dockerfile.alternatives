# Dockerfile.alternatives — drop-in runtime base image options for Stage 3.
#
# To switch, replace the FROM line in Dockerfile (Stage 3) with one of the
# alternatives below.  All three produce a working image; trade-offs differ.

# ── Option A (default) ── quay.io/fedora/nodejs-20-minimal ───────────────────
#
#   FROM --platform=${TARGETPLATFORM:-linux/amd64} quay.io/fedora/nodejs-20-minimal
#
#   Pros:
#     + Public registry — no registry.redhat.io subscription required
#     + Non-root UID 1001 by default → works on OpenShift restricted SCC
#     + Fedora minimal base — small, regularly updated
#     + Node.js 20 LTS included
#   Cons:
#     - Node.js 20 (LTS), not Node.js 22 (the builder uses 22)
#       The backend engines field requires >=18 so this is fine in practice.
#     - dnf package manager (not apk) — heavier than alpine if extra packages needed

# ── Option B ── registry.access.redhat.com/ubi9/nodejs-20 ────────────────────
#
#   FROM --platform=${TARGETPLATFORM:-linux/amd64} registry.access.redhat.com/ubi9/nodejs-20
#
#   Pros:
#     + Public (access.redhat.com, no auth) — Red Hat UBI9
#     + RHEL-certified, Red Hat CVE patching SLA
#     + Non-root UID 1001, OpenShift-native
#     + Full npm/npx available
#   Cons:
#     - Larger than minimal variants (~400 MB compressed)
#     - microdnf package manager

# ── Option C ── docker.io/node:22-alpine ─────────────────────────────────────
#
#   FROM --platform=${TARGETPLATFORM:-linux/amd64} docker.io/node:22-alpine
#
#   Pros:
#     + Smallest image size (~150 MB compressed)
#     + Node.js 22 — matches the builder stage exactly
#     + Multi-arch manifest (amd64, arm64, s390x, ppc64le)
#     + apk package manager — fast, minimal
#   Cons:
#     - Runs as root UID 0 by default — requires explicit USER node or
#       OpenShift anyuid SCC (causes CrashLoopBackOff on restricted SCC)
#     - Docker Hub rate limits in CI
#     - musl libc (not glibc) — occasional binary compat issues
