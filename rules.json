{
  "version": "1.0",
  "global": {
    "commit_trailers": ["Assisted-by"],
    "forbidden_trailers": ["Made-with", "Co-authored-by"],
    "forbidden_labels": ["wontfix", "duplicate", "stale", "lifecycle/stale", "needs-triage", "blocked"],
    "issue_must_be": "open",
    "story_point_budget_per_session": 3
  },
  "auto_approve": {
    "min_priority": "major",
    "priority_order": ["critical", "major", "minor", "trivial"],
    "github_label_map": {
      "priority/critical": "critical",
      "priority/blocker":  "critical",
      "priority/major":    "major",
      "priority/minor":    "minor",
      "priority/trivial":  "trivial"
    },
    "jira_priority_map": {
      "Critical": "critical",
      "Blocker":  "critical",
      "Major":    "major",
      "Normal":   "minor",
      "Minor":    "minor",
      "Trivial":  "trivial"
    },
    "jira_base_url": "https://redhat.atlassian.net"
  },
  "story_points": {
    "1": "trivial: single file, no test changes",
    "2": "small: 1-3 files, minor test update",
    "3": "medium: 3-8 files, new test cases",
    "5": "large: cross-package change, significant tests",
    "8": "complex: architecture change, broad test coverage"
  },
  "issue_scoring": {
    "base": {
      "kind/bug": 10,
      "kind/enhancement": 6,
      "area/docs": 3
    },
    "boosts": {
      "priority/critical": 5,
      "priority/high": 3,
      "has_test_reproduction": 2,
      "linked_failing_ci": 2,
      "has_linked_pr": 3,
      "has_acceptance_criteria": 1,
      "good_first_issue": 1,
      "reporter_is_contributor": 1
    }
  },
