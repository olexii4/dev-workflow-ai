# Required — GitHub integration (issues, PRs, identity)
GITHUB_TOKEN=ghp_...

# LLM — choose one (priority: Vertex AI > Claude API > Gemini > Ollama)

# Claude via Google Cloud Vertex AI (service account or ADC)
# Set ANTHROPIC_VERTEX_PROJECT_ID to enable Vertex AI mode.
# Credentials — pick one:
#   A) GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json   (file-based)
#   B) GOOGLE_APPLICATION_CREDENTIALS_JSON='{...}'            (inline JSON — good for k8s secrets)
ANTHROPIC_VERTEX_PROJECT_ID=
CLOUD_ML_REGION=global
VERTEX_CLAUDE_MODEL=claude-sonnet-4-5@20250929
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Claude API direct (best quality when not using Vertex AI)
ANTHROPIC_API_KEY=

# Gemini (fast, generous free tier — get key at aistudio.google.com/apikey)
# Either name works:
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# External Ollama (running on your intranet or local machine)
# e.g. http://192.168.1.10:11434  or  http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5-coder:7b

# Database — comment out to use PGlite (no server needed)
DATABASE_URL=postgres://agent:agent@localhost:5433/devworkflow
POSTGRES_PASSWORD=agent

# Optional — Jira integration
JIRA_TOKEN=
JIRA_EMAIL=
JIRA_BASE_URL=https://redhat.atlassian.net
